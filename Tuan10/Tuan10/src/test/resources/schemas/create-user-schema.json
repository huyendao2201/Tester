{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Create User Response Schema",
    "description": "Schema for POST /api/users - validates creation response has name, job, id, createdAt, _meta",
    "type": "object",
    "required": [
        "name",
        "job",
        "id",
        "createdAt",
        "_meta"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "job": {
            "type": "string",
            "minLength": 1
        },
        "id": {
            "type": "string",
            "description": "reqres.in trả về id dạng chuỗi số"
        },
        "createdAt": {
            "type": "string",
            "description": "ISO 8601 timestamp"
        },
        "_meta": {
            "type": "object",
            "description": "reqres.in metadata object (added in new API version)",
            "required": [
                "powered_by",
                "docs_url",
                "upgrade_url",
                "example_url",
                "variant",
                "message",
                "cta",
                "context"
            ],
            "additionalProperties": false,
            "properties": {
                "powered_by": {
                    "type": "string"
                },
                "docs_url": {
                    "type": "string"
                },
                "upgrade_url": {
                    "type": "string"
                },
                "example_url": {
                    "type": "string"
                },
                "variant": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "cta": {
                    "type": "object",
                    "required": [
                        "label",
                        "url"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "label": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        }
                    }
                },
                "context": {
                    "type": "string"
                }
            }
        }
    }
}